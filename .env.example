# Kerfvault Root Environment Configuration (Example)
# Copy to .env for local development. Never commit secrets.

# Stellar Network Configuration (Testnet only)
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"

# Deployed Contract ID on Testnet
KERFVAULT_CONTRACT_ID="CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"

# Services Configuration
INDEXER_PORT=4001
INDEXER_DATABASE_URL="postgres://kerfvault:kerfvault@localhost:5432/kerfvault_indexer"
RELAY_PORT=4002
RELAY_FEE_ACCOUNT_SECRET="" # Testnet fee account secret seed (e.g. S...)

# App Public URLs
NEXT_PUBLIC_KERFVAULT_CONTRACT_ID="CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
NEXT_PUBLIC_SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"
NEXT_PUBLIC_INDEXER_URL="http://localhost:4001"
NEXT_PUBLIC_RELAY_URL="http://localhost:4002"
