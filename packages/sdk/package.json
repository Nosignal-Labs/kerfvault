{
  "name": "@kerfvault/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Kerfvault offline vouchers and Soroban contract client",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
